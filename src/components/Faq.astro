---
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 ? (
    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="faq__heading">Frequently asked questions</h2>
      <div class="faq__list">
        {items.map((item) => (
          <details class="faq__item">
            <summary class="faq__question">{item.q}</summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  ) : null
}
