---
import { getCollection } from 'astro:content';
import { hrefForPageId } from '../data/pages';

const groups = [
  {
    id: 'styles',
    label: 'Font Styles',
    slugs: [
      'bold-text-generator',
      'cursive-font-generator',
      'aesthetic-font-generator',
      'gothic-font-generator',
      'bubble-text-generator',
      'number-font-generator',
      'cute-font-generator',
      'small-text-generator',
      'upside-down-text-generator',
    ],
  },
  {
    id: 'social',
    label: 'Social Media',
    slugs: [
      'instagram-fonts',
      'facebook-fonts',
      'tiktok-fonts',
      'discord-fonts',
      'pubg-fonts',
    ],
  },
  {
    id: 'effects',
    label: 'Text Effects',
    slugs: ['glitch-text-generator', 'freaky-font-generator'],
  },
] as const;

const collection = await getCollection('pages');
const byId = new Map(collection.map((page) => [page.id, page]));

const nav = groups.map((group) => ({
  id: group.id,
  label: group.label,
  links: group.slugs.flatMap((slug) => {
    const page = byId.get(slug);
    if (!page) return [];
    return [
      {
        href: hrefForPageId(page.id),
        label: page.data.h1,
      },
    ];
  }),
}));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">Fonti</a>
    <nav class="site-nav" aria-label="Tools">
      <button
        type="button"
        class="site-nav__burger"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="site-nav-drawer"
      >
        <span class="site-nav__burger-icon" aria-hidden="true"></span>
      </button>
      <div class="site-nav__drawer" id="site-nav-drawer">
        {
          nav.map((group) => (
            <div class="site-nav__drop">
              <button
                type="button"
                class="site-nav__btn"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls={`site-nav-${group.id}`}
              >
                {group.label}
              </button>
              <p class="site-nav__label">{group.label}</p>
              <ul class="site-nav__list" id={`site-nav-${group.id}`}>
                {
                  group.links.map((link) => (
                    <li>
                      <a class="site-nav__link" href={link.href}>
                        {link.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
        <a class="site-nav__blog" href="/blog/">Blog</a>
      </div>
    </nav>
  </div>
</header>

<script>
  import '../scripts/header.js';
</script>
