---
import { styles } from '../data/styles';
import { categories } from '../data/categories';
import { applyStyle, countCharacters } from '../scripts/generator.js';

interface Props {
  toolCategories: string[];
  testPhrase?: string;
  /** Content entry id (filename without extension), used in the missing-phrase warning. */
  pageFile: string;
}

const { toolCategories, testPhrase, pageFile } = Astro.props;

if (testPhrase === undefined) {
  console.warn(
    `[fontly] Missing testPhrase in src/content/pages/${pageFile}.md — input will be left empty.`,
  );
}

const prefill = testPhrase ?? '';
const inputCount = countCharacters(prefill);
const inputHasDigit = /\d/.test(prefill);

const categoryLookup = new Map(categories.map((c) => [c.id, c]));

const sections = toolCategories.map((id) => {
  const category = categoryLookup.get(id);
  if (!category) {
    throw new Error(
      `[fontly] Unknown toolCategories id "${id}" in src/content/pages/${pageFile}.md — every id must exist in src/data/categories.ts.`,
    );
  }
  const sectionStyles = styles.filter((s) => s.category === id);
  return { category, styles: sectionStyles };
});

// Chips: All, then categories that actually have styles on this page, then Favourites.
const filterChips = sections
  .filter((s) => s.styles.length > 0)
  .map((s) => ({ id: s.category.id, label: s.category.name }));
---

<section class="tool" data-tool id="fontly-tool">
  <div class="tool__controls">
    <label class="tool__label" for="tool-input">Your text</label>
    <input
      class="tool__input"
      type="text"
      id="tool-input"
      name="tool-input"
      value={prefill}
      autocomplete="off"
      spellcheck="false"
    />
    <div class="tool__case" role="group" aria-label="Case transforms">
      <button type="button" class="tool__case-btn" data-case="upper">UPPERCASE</button>
      <button type="button" class="tool__case-btn" data-case="lower">lowercase</button>
      <button type="button" class="tool__case-btn" data-case="title">Title Case</button>
    </div>
    <p class="tool__input-meta">
      <span class="tool__char-count"
        ><span data-input-codepoints>{inputCount.codePoints}</span> characters</span
      >
      <span class="tool__style-count">{styles.length} styles</span>
    </p>
  </div>

  <div class="tool__live" data-copy-status aria-live="polite"></div>

  <div class="tool__toolbar">
    <div class="tool__filters" role="toolbar" aria-label="Filter styles">
      <button
        type="button"
        class="tool__chip is-active"
        data-filter="all"
        aria-pressed="true">All</button
      >
      {
        filterChips.map((chip) => (
          <button
            type="button"
            class="tool__chip"
            data-filter={chip.id}
            aria-pressed="false"
          >
            {chip.label}
          </button>
        ))
      }
      <button
        type="button"
        class="tool__chip"
        data-filter="favourites"
        aria-pressed="false">Favourites</button
      >
    </div>
    <div class="tool__search">
      <label class="tool__search-label" for="tool-search">Search styles</label>
      <input
        class="tool__search-input"
        type="search"
        id="tool-search"
        name="tool-search"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
  </div>

  <p class="tool__empty" data-favourites-empty hidden>No favourites yet. Tap the star on a card to save it.</p>
  <p class="tool__empty" data-search-empty hidden>No styles match that search.</p>

  {
    sections.map(({ category, styles: sectionStyles }) => (
      <section class="tool__category" data-category={category.id}>
        <h2 class="tool__category-heading">{category.name}</h2>
        <ul class="tool__cards">
          {sectionStyles.map((style) => {
            const output = applyStyle(prefill, style);
            const count = countCharacters(output);
            const showDigitNote = style.digits === null && inputHasDigit;
            return (
              <li
                class="tool-card"
                data-style-id={style.id}
                data-style-name={style.name.toLowerCase()}
                data-category={style.category}
                data-favourite="false"
                data-needs-update="false"
                data-has-digit-note={style.digits === null ? 'true' : 'false'}
              >
                <div class="tool-card__header">
                  <h3 class="tool-card__name">{style.name}</h3>
                  {style.caveat ? (
                    <span class="tool-card__risk">{style.caveat}</span>
                  ) : null}
                  <div class="tool-card__actions">
                    <button
                      type="button"
                      class="tool-card__icon tool-card__fav"
                      data-fav
                      aria-pressed="false"
                      aria-label={`Add ${style.name} to favourites`}
                    >
                      <span aria-hidden="true">★</span>
                    </button>
                    <button
                      type="button"
                      class="tool-card__icon tool-card__copy"
                      data-copy
                      aria-label={`Copy ${style.name}`}
                    >
                      <span class="tool-card__copy-icons" aria-hidden="true">
                        <svg
                          class="tool-card__svg tool-card__svg--copy"
                          viewBox="0 0 24 24"
                          width="18"
                          height="18"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                        </svg>
                        <svg
                          class="tool-card__svg tool-card__svg--done"
                          viewBox="0 0 24 24"
                          width="18"
                          height="18"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M20 6 9 17l-5-5"></path>
                        </svg>
                      </span>
                    </button>
                  </div>
                </div>
                <p class="tool-card__output" data-output>{output}</p>
                <p class="tool-card__units">
                  <span data-counter-utf16>{count.utf16Length}</span> units
                </p>
                {style.digits === null ? (
                  <p
                    class:list={[
                      'tool-card__digits-note',
                      { 'is-quiet': !showDigitNote },
                    ]}
                    data-digits-note
                  >
                    Numbers stay plain.
                  </p>
                ) : null}
                {style.caseNote ? (
                  <p class="tool-card__case-note">{style.caseNote}</p>
                ) : null}
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</section>

<script>
  import '../scripts/tool.js';
</script>
