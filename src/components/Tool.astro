---
import { styles, DIGITS_NOTE, BUILDER_LABEL } from '../data/styles';
import { categories } from '../data/categories';
import { decorations, applyDecoration } from '../data/decorations';
import { effects, applyEffect } from '../data/effects';
import { combinations } from '../data/combinations';
import { applyStyle, applyCombination, countCharacters } from '../scripts/generator.js';

interface Props {
  toolCategories: string[];
  testPhrase?: string;
  /** Renders the Decorated wrapper section after the last style category. */
  showDecorations?: boolean;
  /** Renders the Effects combining-mark section after the last style category. */
  showEffects?: boolean;
  /** Renders the Combined alphabet+decoration section. */
  showCombined?: boolean;
  /** Content entry id (filename without extension), used in the missing-phrase warning. */
  pageFile: string;
}

const {
  toolCategories,
  testPhrase,
  showDecorations = false,
  showEffects = false,
  showCombined = false,
  pageFile,
} = Astro.props;

if (testPhrase === undefined) {
  console.warn(
    `[fonti] Missing testPhrase in src/content/pages/${pageFile}.md — input will be left empty.`,
  );
}

const prefill = '';
const inputCount = countCharacters(prefill);

const categoryLookup = new Map(categories.map((c) => [c.id, c]));

const DECORATION_GROUP_IDS = new Set(
  categories.filter((c) => c.decoration === true).map((c) => c.id),
);

const groupSectionsAttr = categories
  .filter((c) => c.decoration === true)
  .map((c) => c.id)
  .join(' ');
if (!groupSectionsAttr) {
  throw new Error(
    `[fonti] data-group-sections would be empty — no decoration:true categories in src/data/categories.ts.`,
  );
}

for (const decoration of decorations) {
  if (!DECORATION_GROUP_IDS.has(decoration.group)) {
    throw new Error(
      `[fonti] Unknown decoration group "${decoration.group}" on id "${decoration.id}" — every group must be one of the six decoration:true ids in src/data/categories.ts.`,
    );
  }
}

/**
 * Membership string for a decoration card. cute is derived from stars/hearts.
 */
function decorationMembership(group: string): string {
  let membership = `decorated ${group}`;
  if (group === 'stars' || group === 'hearts') {
    membership += ' cute';
  }
  return membership;
}

interface Card {
  id: string;
  name: string;
  searchName: string;
  output: string;
  caveat: string | null;
  caveatNote: string | null;
  caseNote: string | null;
  digitsPassThrough: boolean;
  /** Space-separated membership ids for data-categories. */
  membership: string;
}

interface Section {
  id: string;
  heading: string;
  /** Short public note under the heading. null on style categories. */
  note: string | null;
  decorated: boolean;
  cards: Card[];
  /** Interactive Combo builder section — no cards, no tool__cards list. */
  builder?: boolean;
}

function styleCard(style: (typeof styles)[number]): Card {
  const output = applyStyle(style.name, style);
  return {
    id: style.id,
    name: style.name,
    searchName: style.name.toLowerCase(),
    output,
    caveat: style.caveat,
    caveatNote: style.caveatNote ?? null,
    caseNote: style.caseNote,
    digitsPassThrough: style.digits === null,
    membership: style.categories.join(' '),
  };
}

// Decorations get their section from the group field; cute is derived in
// decorationMembership, never stored on a record.
function decorationCards(groupId: string): Card[] {
  return decorations
    .filter((decoration) => decoration.group === groupId)
    .map((decoration) => {
      const output = applyDecoration(decoration.name, decoration);
      return {
        id: decoration.id,
        name: decoration.name,
        searchName: decoration.name.toLowerCase(),
        output,
        caveat: decoration.caveat,
        caveatNote: null,
        caseNote: null,
        digitsPassThrough: false,
        membership: decorationMembership(decoration.group),
      };
    });
}

function effectCards(): Card[] {
  return effects.map((effect) => {
    const output = applyEffect(effect.name, effect);
    return {
      id: effect.id,
      name: effect.name,
      searchName: effect.name.toLowerCase(),
      output,
      caveat: effect.caveat,
      caveatNote: effect.caveatNote,
      caseNote: null,
      digitsPassThrough: false,
      membership: 'effects',
    };
  });
}

const styleById = new Map(styles.map((s) => [s.id, s]));
const decorationById = new Map(decorations.map((d) => [d.id, d]));

function combinationCards(): Card[] {
  return combinations.map((combination) => {
    const style = styleById.get(combination.style)!;
    const decoration = decorationById.get(combination.decoration)!;
    const output = applyCombination(testPhrase ?? '', style, decoration);
    return {
      id: combination.id,
      name: combination.name,
      searchName: combination.name.toLowerCase(),
      output,
      caveat: style.caveat,
      caveatNote: style.caveatNote ?? null,
      caseNote: style.caseNote,
      digitsPassThrough: style.digits === null,
      membership: combination.categories.join(' '),
    };
  });
}

const sections: Section[] = toolCategories.map((id) => {
  const category = categoryLookup.get(id);
  if (!category) {
    throw new Error(
      `[fonti] Unknown toolCategories id "${id}" in src/content/pages/${pageFile}.md — every id must exist in src/data/categories.ts.`,
    );
  }
  if (DECORATION_GROUP_IDS.has(id)) {
    return {
      id: category.id,
      heading: category.heading ?? category.name,
      note: 'Decoration wrapped around your text, letters unchanged.',
      decorated: true,
      cards: showDecorations ? decorationCards(id) : [],
    };
  }
  if (id === 'effects') {
    return {
      id: category.id,
      heading: category.heading ?? category.name,
      note: 'Marks added over your text, letters unchanged.',
      decorated: true,
      cards: showEffects ? effectCards() : [],
    };
  }
  if (id === 'combined') {
    return {
      id: category.id,
      heading: category.heading ?? category.name,
      note: 'An alphabet wrapped in a decoration.',
      decorated: true,
      cards: showCombined ? combinationCards() : [],
    };
  }
  if (id === 'combo') {
    return {
      id: category.id,
      heading: category.heading ?? category.name,
      note: 'Pick an alphabet, a separator and a decoration, then copy the result.',
      decorated: false,
      cards: [],
      builder: true,
    };
  }
  return {
    id: category.id,
    heading: category.heading ?? category.name,
    note: null,
    decorated: false,
    cards: styles.filter((style) => style.categories.includes(id)).map(styleCard),
  };
});

const sectionById = new Map(sections.map((section) => [section.id, section]));
// Builder sections first so the builder sits above the card sections when shown.
// First card section stays the SSR-mounted one (was toolCategories[0]).
const builderSections = sections.filter((section) => section.builder);
const cardSections = sections.filter((section) => !section.builder);
const displaySections = [...builderSections, ...cardSections];
const firstCardSectionId = cardSections[0]?.id;
// Chip order follows categories.ts. cool-fonts, cute and decorated are chips
// with no section. Entries with chip: false are sections only.
const filterChips = categories
  .filter((category) => {
    if (category.chip === false) return false;
    if (category.id === 'all' || category.id === 'favourites' || category.id === 'recent') {
      return false;
    }
    if (
      category.id === 'cool-fonts' ||
      category.id === 'cute' ||
      category.id === 'decorated'
    ) {
      return true;
    }
    const section = sectionById.get(category.id);
    return section !== undefined && section.cards.length > 0;
  })
  .map((category) => ({ id: category.id, label: category.name }));
---

<section class="tool" data-tool id="fonti-tool" data-group-sections={groupSectionsAttr}>
  <svg class="tool__sprite" aria-hidden="true" focusable="false">
    <symbol
      id="icon-copy"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </symbol>
    <symbol
      id="icon-done"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </symbol>
  </svg>
  <div class="tool__controls">
    <input
      class="tool__input"
      type="text"
      id="tool-input"
      name="tool-input"
      value={prefill}
      placeholder="Enter text here"
      aria-label="Your text"
      autocomplete="off"
      spellcheck="false"
    />
  </div>

  <div class="tool__live" data-copy-status aria-live="polite"></div>

  <div class="tool__toolbar">
    <div class="tool__filters-wrap">
      <div class="tool__filters" role="toolbar" aria-label="Filter styles and decorations">
        <button
          type="button"
          class="tool__chip is-active"
          data-filter="all"
          aria-pressed="true">All</button
        >
        {
          filterChips.map((chip) => (
            <button
              type="button"
              class="tool__chip"
              data-filter={chip.id}
              aria-pressed="false"
            >
              {chip.label}
            </button>
          ))
        }
        <button
          type="button"
          class="tool__chip"
          data-filter="favourites"
          aria-pressed="false">Favourites</button
        >
        <button
          type="button"
          class="tool__chip"
          data-filter="recent"
          aria-pressed="false">Recent</button
        >
      </div>
      <div class="tool__filters-cue" aria-hidden="true">
        <svg
          class="tool__filters-chevron"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 3l5 5-5 5"></path>
        </svg>
      </div>
    </div>
    <div class="tool__row">
      <div class="tool__case" role="group" aria-label="Case transforms">
        <button type="button" class="tool__case-btn" data-case="upper">UPPERCASE</button>
        <button type="button" class="tool__case-btn" data-case="lower">lowercase</button>
        <button type="button" class="tool__case-btn" data-case="title">Title Case</button>
        <button
          type="button"
          class="tool__case-btn"
          data-filter="combo"
          aria-pressed="false"
        >{BUILDER_LABEL}</button>
        <button
          type="button"
          class="tool__case-btn"
          aria-expanded="false"
          aria-controls="tool-live-preview"
        >Live preview</button>
      </div>
      <div class="tool__end">
        <div class="tool__preview">
          <label class="tool__preview-label" for="tool-preview-size">
            <svg
              class="tool__preview-icon"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1 13 L4 3 L7 13"></path>
              <path d="M2.2 10 H5.8"></path>
              <path d="M9 13 L12 6 L15 13"></path>
              <path d="M10.2 11 H13.8"></path>
            </svg>
            Preview size
          </label>
          <input
            class="tool__preview-input"
            type="range"
            id="tool-preview-size"
            name="tool-preview-size"
            min="0"
            max="2"
            step="1"
            value="1"
            aria-label="Preview size"
          />
        </div>
        <div class="tool__search">
          <input
            class="tool__search-input"
            type="search"
            id="tool-search"
            name="tool-search"
            placeholder="Search"
            aria-label="Search styles and decorations"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="tool__live-panel" id="tool-live-preview" hidden>
    <div
      class="tool__case"
      role="group"
      aria-label="Preview target"
      data-live-target-row
    >
      <button
        type="button"
        class="tool__case-btn"
        data-live-target="name"
        aria-pressed="false"
      >Name</button>
      <button
        type="button"
        class="tool__case-btn is-active"
        data-live-target="bio"
        aria-pressed="true"
      >Bio</button>
      <button
        type="button"
        class="tool__case-btn"
        data-live-target="both"
        aria-pressed="false"
      >Both</button>
    </div>
    <p class="tool__live-panel-style" data-live-style>Style: Bold Script</p>
    <div class="tool__live-mockups">
      <article class="mockup mockup--ig" aria-label="Instagram bio">
        <p class="mockup__name" aria-hidden="true">your_username</p>
        <div class="mockup__ig-header">
          <div class="mockup__avatar mockup__avatar--ig" aria-hidden="true"></div>
          <div class="mockup__statrow" aria-hidden="true">
            <div class="mockup__stat">
              <span class="mockup__stat-n">212</span>
              <span class="mockup__stat-l">Posts</span>
            </div>
            <div class="mockup__stat">
              <span class="mockup__stat-n">14.2K</span>
              <span class="mockup__stat-l">Followers</span>
            </div>
            <div class="mockup__stat">
              <span class="mockup__stat-n">88</span>
              <span class="mockup__stat-l">Following</span>
            </div>
          </div>
        </div>
        <p class="mockup__brand" data-live-ig-name>Your Brand Name</p>
        <p class="mockup__bio" data-live-ig-bio>Hello World</p>
        <p class="mockup__link" aria-hidden="true">yourbrandwebsite.com</p>
        <div class="mockup__actions" aria-hidden="true">
          <span class="mockup__pill mockup__pill--accent">Follow</span>
          <span class="mockup__pill mockup__pill--quiet">Message</span>
          <span class="mockup__pill mockup__pill--quiet mockup__pill--plus">+</span>
        </div>
        <div class="mockup__highlights" aria-hidden="true">
          <div class="mockup__hl" aria-hidden="true">
            <span class="mockup__hl-dot" aria-hidden="true"></span>
            <span class="mockup__hl-l" aria-hidden="true">Highlight</span>
          </div>
          <div class="mockup__hl" aria-hidden="true">
            <span class="mockup__hl-dot" aria-hidden="true"></span>
            <span class="mockup__hl-l" aria-hidden="true">Highlight</span>
          </div>
          <div class="mockup__hl" aria-hidden="true">
            <span class="mockup__hl-dot" aria-hidden="true"></span>
            <span class="mockup__hl-l" aria-hidden="true">Highlight</span>
          </div>
          <div class="mockup__hl" aria-hidden="true">
            <span class="mockup__hl-dot" aria-hidden="true"></span>
            <span class="mockup__hl-l" aria-hidden="true">Highlight</span>
          </div>
          <div class="mockup__hl" aria-hidden="true">
            <span class="mockup__hl-dot" aria-hidden="true"></span>
            <span class="mockup__hl-l" aria-hidden="true">Highlight</span>
          </div>
        </div>
        <p class="mockup__meta" data-live-ig-meta>11 / 150</p>
        <p class="mockup__caption" data-live-ig-caption aria-hidden="true">Instagram bio preview</p>
      </article>
      <article class="mockup mockup--tt" aria-label="TikTok profile">
        <div class="mockup__ring mockup__ring--tt" aria-hidden="true">
          <div class="mockup__avatar mockup__avatar--tt"></div>
        </div>
        <p class="mockup__handle" aria-hidden="true">@your_handle</p>
        <p class="mockup__name" data-live-tt-name>Hello World</p>
        <div class="mockup__statrow" aria-hidden="true">
          <div class="mockup__stat">
            <span class="mockup__stat-n">316</span>
            <span class="mockup__stat-l">Following</span>
          </div>
          <div class="mockup__stat">
            <span class="mockup__stat-n">1.2M</span>
            <span class="mockup__stat-l">Followers</span>
          </div>
          <div class="mockup__stat">
            <span class="mockup__stat-n">8.4M</span>
            <span class="mockup__stat-l">Likes</span>
          </div>
        </div>
        <div class="mockup__actions" aria-hidden="true">
          <span class="mockup__follow">Follow</span>
        </div>
        <p class="mockup__bio" data-live-tt-bio>Hello World</p>
        <p class="mockup__meta" data-live-tt-meta>11 / 80</p>
        <p class="mockup__caption" data-live-tt-caption aria-hidden="true">TikTok bio preview</p>
      </article>
    </div>
  </div>

  <p class="tool__empty" data-favourites-empty hidden>No favourites yet. Tap the star on a card to save it.</p>
  <p class="tool__empty" data-recents-empty hidden>Nothing copied yet.</p>
  <p class="tool__empty" data-search-empty hidden>Nothing matches that search.</p>

  {/*
    Single card markup source. tool.js clones this for on-demand sections.
    Do not duplicate this markup as a string in JavaScript.
  */}
  <template id="tool-card-template">
    <li
      class="tool-card"
      data-card-id=""
      data-card-name=""
      data-category=""
      data-categories=""
      data-favourite="false"
      data-needs-update="false"
      data-has-digit-note="false"
    >
      <div class="tool-card__header">
        <h3 class="tool-card__name"></h3>
        <span class="tool-card__risk" hidden></span>
        <div class="tool-card__actions">
          <button
            type="button"
            class="tool-card__icon tool-card__fav"
            data-fav
            aria-pressed="false"
            aria-label=""
          >
            <span aria-hidden="true">★</span>
          </button>
          <button
            type="button"
            class="tool-card__icon tool-card__copy"
            data-copy
            aria-label=""
          >
            <svg
              class="tool-card__svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <use href="#icon-copy"></use>
            </svg>
          </button>
        </div>
      </div>
      <p class="tool-card__output" data-output></p>
      <p class="tool-card__digits-note is-quiet" data-digits-note hidden>
        {DIGITS_NOTE}
      </p>
      <p class="tool-card__case-note" hidden></p>
      <p class="tool-card__caveat-note" hidden></p>
    </li>
  </template>

  {
    displaySections.map((section) => (
      <section
        class:list={['tool__category', { tool__decorated: section.decorated }]}
        data-category={section.id}
        data-mounted={section.id === firstCardSectionId ? 'true' : 'false'}
        hidden={section.builder ? true : undefined}
      >
        <h2 class="tool__category-heading">{section.heading}</h2>
        {section.note ? <p class="tool__section-note">{section.note}</p> : null}
        {
          section.builder ? (
            <div class="tool__combo">
              <div class="tool__combo-preview">
                <div class="tool__combo-preview-header">
                  <p class="tool__combo-preview-label">Live preview</p>
                  <button
                    type="button"
                    class="tool-card__icon tool-card__copy"
                    data-copy="combo"
                    aria-label="Copy combo result"
                  >
                    <svg
                      class="tool-card__svg"
                      viewBox="0 0 24 24"
                      width="18"
                      height="18"
                      aria-hidden="true"
                    >
                      <use href="#icon-copy"></use>
                    </svg>
                  </button>
                </div>
                <p class="tool__combo-output" data-combo-output></p>
                <p class="tool__combo-count"><span data-combo-count>0</span> units</p>
              </div>
              <div class="tool__combo-panel">
                <h3 class="tool__combo-heading">1. Base font</h3>
                <div
                  class="tool__combo-group"
                  role="group"
                  aria-label="Base font"
                  id="tool-combo-style"
                ></div>
                <div class="tool__combo-notes" data-combo-notes>
                  <span class="tool-card__risk" data-combo-caveat hidden></span>
                  <p class="tool-card__case-note" data-combo-case-note hidden></p>
                  <p
                    class="tool-card__digits-note is-quiet"
                    data-combo-digits-note
                    hidden
                  ></p>
                  <p
                    class="tool-card__caveat-note"
                    data-combo-caveat-note
                    hidden
                  ></p>
                </div>
              </div>
              <div class="tool__combo-panel">
                <h3 class="tool__combo-heading">2. Separator</h3>
                <div
                  class="tool__combo-group"
                  role="group"
                  aria-label="Separator"
                  id="tool-combo-separator"
                ></div>
              </div>
              <div class="tool__combo-panel">
                <h3 class="tool__combo-heading">3. Wrapper</h3>
                <div
                  class="tool__combo-group"
                  role="group"
                  aria-label="Wrapper"
                  id="tool-combo-wrapper"
                ></div>
              </div>
            </div>
          ) : (
            <ul class="tool__cards">
              {
                section.id === firstCardSectionId
                  ? section.cards.map((card) => (
                      <li
                        class="tool-card"
                        data-card-id={card.id}
                        data-card-name={card.searchName}
                        data-category={section.id}
                        data-categories={card.membership}
                        data-favourite="false"
                        data-needs-update="false"
                        data-has-digit-note={card.digitsPassThrough ? 'true' : 'false'}
                      >
                        <div class="tool-card__header">
                          <h3 class="tool-card__name">{card.name}</h3>
                          {card.caveat ? <span class="tool-card__risk">{card.caveat}</span> : null}
                          <div class="tool-card__actions">
                            <button
                              type="button"
                              class="tool-card__icon tool-card__fav"
                              data-fav
                              aria-pressed="false"
                              aria-label={`Add ${card.name} to favourites`}
                            >
                              <span aria-hidden="true">★</span>
                            </button>
                            <button
                              type="button"
                              class="tool-card__icon tool-card__copy"
                              data-copy
                              aria-label={`Copy ${card.name}`}
                            >
                              <svg
                                class="tool-card__svg"
                                viewBox="0 0 24 24"
                                width="18"
                                height="18"
                                aria-hidden="true"
                              >
                                <use href="#icon-copy"></use>
                              </svg>
                            </button>
                          </div>
                        </div>
                        <p class="tool-card__output" data-output>{card.output}</p>
                        {card.digitsPassThrough ? (
                          <p class="tool-card__digits-note is-quiet" data-digits-note hidden>
                            {DIGITS_NOTE}
                          </p>
                        ) : null}
                        {card.caseNote ? <p class="tool-card__case-note">{card.caseNote}</p> : null}
                        {card.caveatNote ? (
                          <p class="tool-card__caveat-note">{card.caveatNote}</p>
                        ) : null}
                      </li>
                    ))
                  : null
              }
            </ul>
          )
        }
      </section>
    ))
  }

  <div class="tool__below">
    <p class="tool__input-meta">
      <span class="tool__char-count"
        ><span data-input-codepoints>{inputCount.codePoints}</span> characters</span
      >
      <span class="tool__style-count"
        >{styles.length + decorations.length + effects.length + combinations.length} styles</span
      >
    </p>
  </div>
</section>

<script>
  import '../scripts/tool.js';
</script>
