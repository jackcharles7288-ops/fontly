---
import { styles } from '../data/styles';
import { categories } from '../data/categories';
import { decorations, applyDecoration } from '../data/decorations';
import { effects, applyEffect } from '../data/effects';
import { applyStyle, countCharacters } from '../scripts/generator.js';

interface Props {
  toolCategories: string[];
  testPhrase?: string;
  /** Renders the Decorated wrapper section after the last style category. */
  showDecorations?: boolean;
  /** Renders the Effects combining-mark section after the last style category. */
  showEffects?: boolean;
  /** Content entry id (filename without extension), used in the missing-phrase warning. */
  pageFile: string;
}

const { toolCategories, testPhrase, showDecorations = false, showEffects = false, pageFile } = Astro.props;

if (testPhrase === undefined) {
  console.warn(
    `[fontly] Missing testPhrase in src/content/pages/${pageFile}.md — input will be left empty.`,
  );
}

const prefill = '';
const inputCount = countCharacters(prefill);

const categoryLookup = new Map(categories.map((c) => [c.id, c]));

interface Card {
  id: string;
  name: string;
  searchName: string;
  output: string;
  utf16Length: number;
  caveat: string | null;
  caveatNote: string | null;
  caseNote: string | null;
  digitsPassThrough: boolean;
}

interface Section {
  id: string;
  heading: string;
  /** Short public note under the heading. null on style categories. */
  note: string | null;
  decorated: boolean;
  cards: Card[];
}

const styleSections: Section[] = toolCategories.map((id) => {
  const category = categoryLookup.get(id);
  if (!category) {
    throw new Error(
      `[fontly] Unknown toolCategories id "${id}" in src/content/pages/${pageFile}.md — every id must exist in src/data/categories.ts.`,
    );
  }
  return {
    id: category.id,
    heading: category.name,
    note: null,
    decorated: false,
    cards: styles
      .filter((style) => style.category === id)
      .map((style) => {
        // Empty input: the sample is the style's own name.
        const output = applyStyle(style.name, style);
        return {
          id: style.id,
          name: style.name,
          searchName: style.name.toLowerCase(),
          output,
          utf16Length: countCharacters(output).utf16Length,
          caveat: style.caveat,
          caveatNote: style.caveatNote ?? null,
          caseNote: style.caseNote,
          digitsPassThrough: style.digits === null,
        };
      }),
  };
});

// Decorations are wrappers, not alphabets: their own section, never a category
// in categories.ts, and never counted in styles.length.
const decoratedSection: Section = {
  id: 'decorated',
  heading: 'Decorated',
  note: 'Decoration wrapped around your text, letters unchanged.',
  decorated: true,
  cards: decorations.map((decoration) => {
    const output = applyDecoration(decoration.name, decoration);
    return {
      id: decoration.id,
      name: decoration.name,
      searchName: decoration.name.toLowerCase(),
      output,
      utf16Length: countCharacters(output).utf16Length,
      caveat: decoration.caveat,
      caveatNote: null,
      caseNote: null,
      digitsPassThrough: false,
    };
  }),
};

// Effects are combining marks, not alphabets or wrappers: their own section,
// never a category in categories.ts, and never counted in styles.length.
const effectsSection: Section = {
  id: 'effects',
  heading: 'Effects',
  note: 'Marks added over your text, letters unchanged.',
  decorated: true,
  cards: effects.map((effect) => {
    const output = applyEffect(effect.name, effect);
    return {
      id: effect.id,
      name: effect.name,
      searchName: effect.name.toLowerCase(),
      output,
      utf16Length: countCharacters(output).utf16Length,
      caveat: effect.caveat,
      caveatNote: effect.caveatNote,
      caseNote: null,
      digitsPassThrough: false,
    };
  }),
};

const renderDecorated = showDecorations && decoratedSection.cards.length > 0;
const renderEffects = showEffects && effectsSection.cards.length > 0;
const sections = [
  ...styleSections,
  ...(renderEffects ? [effectsSection] : []),
  ...(renderDecorated ? [decoratedSection] : []),
];

// Chips: All, then style categories present on this page, then Decorated,
// then Favourites, then Recents last.
const filterChips = styleSections
  .filter((section) => section.cards.length > 0)
  .map((section) => ({ id: section.id, label: section.heading }));
---

<section class="tool" data-tool id="fontly-tool">
  <svg class="tool__sprite" aria-hidden="true" focusable="false">
    <symbol
      id="icon-copy"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </symbol>
    <symbol
      id="icon-done"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </symbol>
  </svg>
  <div class="tool__controls">
    <input
      class="tool__input"
      type="text"
      id="tool-input"
      name="tool-input"
      value={prefill}
      placeholder="Enter text here"
      aria-label="Your text"
      autocomplete="off"
      spellcheck="false"
    />
  </div>

  <div class="tool__live" data-copy-status aria-live="polite"></div>

  <div class="tool__toolbar">
    <div class="tool__filters-wrap">
      <div class="tool__filters" role="toolbar" aria-label="Filter styles and decorations">
        <button
          type="button"
          class="tool__chip is-active"
          data-filter="all"
          aria-pressed="true">All</button
        >
        {
          filterChips.map((chip) => (
            <button
              type="button"
              class="tool__chip"
              data-filter={chip.id}
              aria-pressed="false"
            >
              {chip.label}
            </button>
          ))
        }
        {
          renderEffects ? (
            <button
              type="button"
              class="tool__chip"
              data-filter="effects"
              aria-pressed="false"
            >
              Effects
            </button>
          ) : null
        }
        {
          renderDecorated ? (
            <button
              type="button"
              class="tool__chip"
              data-filter="decorated"
              aria-pressed="false"
            >
              Decorated
            </button>
          ) : null
        }
        <button
          type="button"
          class="tool__chip"
          data-filter="favourites"
          aria-pressed="false">Favourites</button
        >
        <button
          type="button"
          class="tool__chip"
          data-filter="recent"
          aria-pressed="false">Recent</button
        >
      </div>
      <div class="tool__filters-cue" aria-hidden="true">
        <svg
          class="tool__filters-chevron"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M6 3l5 5-5 5"></path>
        </svg>
      </div>
    </div>
    <div class="tool__row">
      <div class="tool__case" role="group" aria-label="Case transforms">
        <button type="button" class="tool__case-btn" data-case="upper">UPPERCASE</button>
        <button type="button" class="tool__case-btn" data-case="lower">lowercase</button>
        <button type="button" class="tool__case-btn" data-case="title">Title Case</button>
      </div>
      <div class="tool__end">
        <div class="tool__preview">
          <label class="tool__preview-label" for="tool-preview-size">
            <svg
              class="tool__preview-icon"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M1 13 L4 3 L7 13"></path>
              <path d="M2.2 10 H5.8"></path>
              <path d="M9 13 L12 6 L15 13"></path>
              <path d="M10.2 11 H13.8"></path>
            </svg>
            Preview size
          </label>
          <input
            class="tool__preview-input"
            type="range"
            id="tool-preview-size"
            name="tool-preview-size"
            min="0"
            max="2"
            step="1"
            value="1"
            aria-label="Preview size"
          />
        </div>
        <div class="tool__search">
          <input
            class="tool__search-input"
            type="search"
            id="tool-search"
            name="tool-search"
            placeholder="Search"
            aria-label="Search styles and decorations"
            autocomplete="off"
            spellcheck="false"
          />
        </div>
      </div>
    </div>
  </div>

  <p class="tool__empty" data-favourites-empty hidden>No favourites yet. Tap the star on a card to save it.</p>
  <p class="tool__empty" data-recents-empty hidden>Nothing copied yet.</p>
  <p class="tool__empty" data-search-empty hidden>Nothing matches that search.</p>

  {/*
    Single card markup source. tool.js clones this for on-demand sections.
    Do not duplicate this markup as a string in JavaScript.
  */}
  <template id="tool-card-template">
    <li
      class="tool-card"
      data-card-id=""
      data-card-name=""
      data-category=""
      data-favourite="false"
      data-needs-update="false"
      data-has-digit-note="false"
    >
      <div class="tool-card__header">
        <h3 class="tool-card__name"></h3>
        <span class="tool-card__risk" hidden></span>
        <div class="tool-card__actions">
          <button
            type="button"
            class="tool-card__icon tool-card__fav"
            data-fav
            aria-pressed="false"
            aria-label=""
          >
            <span aria-hidden="true">★</span>
          </button>
          <button
            type="button"
            class="tool-card__icon tool-card__copy"
            data-copy
            aria-label=""
          >
            <svg
              class="tool-card__svg"
              viewBox="0 0 24 24"
              width="18"
              height="18"
              aria-hidden="true"
            >
              <use href="#icon-copy"></use>
            </svg>
          </button>
        </div>
      </div>
      <p class="tool-card__output" data-output></p>
      <p class="tool-card__units" hidden>
        <span data-counter-utf16>0</span> units
      </p>
      <p class="tool-card__digits-note is-quiet" data-digits-note hidden>
        Numbers stay plain.
      </p>
      <p class="tool-card__case-note" hidden></p>
      <p class="tool-card__caveat-note" hidden></p>
    </li>
  </template>

  {
    sections.map((section, sectionIndex) => (
      <section
        class:list={['tool__category', { tool__decorated: section.decorated }]}
        data-category={section.id}
        data-mounted={sectionIndex === 0 ? 'true' : 'false'}
      >
        <h2 class="tool__category-heading">{section.heading}</h2>
        {section.note ? <p class="tool__section-note">{section.note}</p> : null}
        <ul class="tool__cards">
          {
            sectionIndex === 0
              ? section.cards.map((card) => (
                  <li
                    class="tool-card"
                    data-card-id={card.id}
                    data-card-name={card.searchName}
                    data-category={section.id}
                    data-favourite="false"
                    data-needs-update="false"
                    data-has-digit-note={card.digitsPassThrough ? 'true' : 'false'}
                  >
                    <div class="tool-card__header">
                      <h3 class="tool-card__name">{card.name}</h3>
                      {card.caveat ? <span class="tool-card__risk">{card.caveat}</span> : null}
                      <div class="tool-card__actions">
                        <button
                          type="button"
                          class="tool-card__icon tool-card__fav"
                          data-fav
                          aria-pressed="false"
                          aria-label={`Add ${card.name} to favourites`}
                        >
                          <span aria-hidden="true">★</span>
                        </button>
                        <button
                          type="button"
                          class="tool-card__icon tool-card__copy"
                          data-copy
                          aria-label={`Copy ${card.name}`}
                        >
                          <svg
                            class="tool-card__svg"
                            viewBox="0 0 24 24"
                            width="18"
                            height="18"
                            aria-hidden="true"
                          >
                            <use href="#icon-copy"></use>
                          </svg>
                        </button>
                      </div>
                    </div>
                    <p class="tool-card__output" data-output>{card.output}</p>
                    <p class="tool-card__units" hidden>
                      <span data-counter-utf16>{card.utf16Length}</span> units
                    </p>
                    {card.digitsPassThrough ? (
                      <p class="tool-card__digits-note is-quiet" data-digits-note hidden>
                        Numbers stay plain.
                      </p>
                    ) : null}
                    {card.caseNote ? <p class="tool-card__case-note">{card.caseNote}</p> : null}
                    {card.caveatNote ? (
                      <p class="tool-card__caveat-note">{card.caveatNote}</p>
                    ) : null}
                  </li>
                ))
              : null
          }
        </ul>
      </section>
    ))
  }

  <div class="tool__below">
    <p class="tool__input-meta">
      <span class="tool__char-count"
        ><span data-input-codepoints>{inputCount.codePoints}</span> characters</span
      >
      <span class="tool__style-count">{styles.length} styles</span>
    </p>
  </div>
</section>

<script>
  import '../scripts/tool.js';
</script>
