---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  /** Omit on the 404 document — an error page must not claim a single indexable URL. */
  canonical?: string;
  noindex?: boolean;
  /** Short intro under the h1. Omit the element when absent. */
  heroIntro?: string;
  /** Overrides og:title. Falls back to title. */
  ogTitle?: string;
  /** Overrides og:description. Falls back to description. */
  ogDescription?: string;
  /** Overrides og:image and twitter:image. Falls back to the site-wide card. */
  ogImage?: string;
}

const { title, description, h1, canonical, noindex = false, heroIntro, ogTitle, ogDescription, ogImage } = Astro.props;
const socialTitle = ogTitle ?? title;
const socialDescription = ogDescription ?? description;
const socialImage = new URL(ogImage ?? '/images/og-card.webp', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <meta property="og:site_name" content="Fonti" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:image" content={socialImage} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      {/* h1 sits in the article measure so it shares one left edge with prose. */}
      <div class="article article--title">
        <h1>{h1}</h1>
      </div>
      {
        heroIntro ? (
          <p class="hero-intro">{heroIntro}</p>
        ) : null
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>
