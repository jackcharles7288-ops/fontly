---
// Undocumented API: createSatteriMarkdownProcessor is not in Astro's published
// docs. The documented alternative is satteri() on markdown.processor together
// with satteriHeadingIdsPlugin. We pin @astrojs/markdown-satteri at an exact
// version because this path renders every article body for the TOOL PLACEHOLDER split.
import * as markdownSatteri from '@astrojs/markdown-satteri';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Tool from '../components/Tool.astro';
import Faq from '../components/Faq.astro';
import RelatedTools from '../components/RelatedTools.astro';
import Schema from '../components/Schema.astro';
import HomeVideo from '../components/HomeVideo.astro';
import { collectArticleImages } from '../lib/article-images';
import { HOME_VIDEO } from '../data/home-video';

const SATTERI_PINNED_VERSION = '0.3.7';
const createSatteriMarkdownProcessor = markdownSatteri.createSatteriMarkdownProcessor;

if (typeof createSatteriMarkdownProcessor !== 'function') {
  throw new Error(
    `[fonti] @astrojs/markdown-satteri@${SATTERI_PINNED_VERSION}: createSatteriMarkdownProcessor is missing or not a function. ` +
      `Documented alternative: configure satteri() on markdown.processor together with satteriHeadingIdsPlugin.`,
  );
}

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    // index.md has entry id "index"; map it to the site root, not /index/.
    const routeSlug = page.id === 'index' ? undefined : page.id;
    return {
      params: { slug: routeSlug },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const pageFile = `${page.id}.md`;

const path = page.id === 'index' ? '/' : `/${page.id}/`;
const canonical = new URL(path, Astro.site).href;

// Replace the exact body line TOOL PLACEHOLDER with the Tool component.
// Sätteri turns that line into <p>TOOL PLACEHOLDER</p>; split on that HTML.
const PLACEHOLDER_LINE = 'TOOL PLACEHOLDER';
const PLACEHOLDER_HTML = `<p>${PLACEHOLDER_LINE}</p>`;
const processor = await createSatteriMarkdownProcessor();
const { code: articleHtml } = await processor.render(page.body ?? '');

const markerCount = articleHtml.split(PLACEHOLDER_HTML).length - 1;
const hasToolCategories = page.data.toolCategories.length > 0;

if (hasToolCategories && markerCount === 0) {
  throw new Error(
    `[fonti] Page src/content/pages/${pageFile} sets toolCategories but the rendered HTML contains no TOOL PLACEHOLDER marker.`,
  );
}
if (markerCount > 1) {
  throw new Error(
    `[fonti] Page src/content/pages/${pageFile} contains TOOL PLACEHOLDER more than once (${markerCount} times). Exactly one marker is required.`,
  );
}
if (!hasToolCategories && markerCount === 1) {
  throw new Error(
    `[fonti] Page src/content/pages/${pageFile} contains TOOL PLACEHOLDER but sets no toolCategories.`,
  );
}

const parts = articleHtml.split(PLACEHOLDER_HTML);
const hasPlaceholder = markerCount === 1;

const VIDEO_PLACEHOLDER_LINE = 'HOME VIDEO PLACEHOLDER';
const VIDEO_PLACEHOLDER_HTML = `<p>${VIDEO_PLACEHOLDER_LINE}</p>`;
const videoMarkerCount = articleHtml.split(VIDEO_PLACEHOLDER_HTML).length - 1;
if (page.id === 'index') {
  if (videoMarkerCount !== 1) {
    throw new Error(
      `[fonti] Homepage must contain exactly one HOME VIDEO PLACEHOLDER (found ${videoMarkerCount}).`,
    );
  }
} else if (videoMarkerCount > 0) {
  throw new Error(
    `[fonti] Page src/content/pages/${pageFile} must not contain HOME VIDEO PLACEHOLDER.`,
  );
}

let belowBefore = parts[1] ?? '';
let belowAfter = '';
let showHomeVideo = false;
if (page.id === 'index') {
  const videoParts = belowBefore.split(VIDEO_PLACEHOLDER_HTML);
  if (videoParts.length !== 2) {
    throw new Error(
      `[fonti] Homepage HOME VIDEO PLACEHOLDER must sit in the below-tool article body exactly once.`,
    );
  }
  belowBefore = videoParts[0] ?? '';
  belowAfter = videoParts[1] ?? '';
  showHomeVideo = true;
}

const articleImages = await collectArticleImages(
  [parts[0], belowBefore, belowAfter].filter(Boolean).join('\n'),
  Astro.site!,
);

const homeVideoSchema = showHomeVideo
  ? {
      '@id': new URL('/#fonti-overview-video', Astro.site).href,
      name: HOME_VIDEO.title,
      description: HOME_VIDEO.description,
      thumbnailUrl: new URL(HOME_VIDEO.thumbnail.path1200, Astro.site).href,
      uploadDate: HOME_VIDEO.uploadDate,
      duration: HOME_VIDEO.duration,
      embedUrl: HOME_VIDEO.embedUrl,
      url: HOME_VIDEO.watchUrl,
    }
  : undefined;

const breadcrumbs =
  page.id === 'index'
    ? []
    : [
        { name: 'Home', url: new URL('/', Astro.site).href },
        { name: page.data.h1, url: canonical },
      ];
---

<PageLayout
  title={page.data.title}
  description={page.data.description}
  h1={page.data.h1}
  canonical={canonical}
  heroIntro={page.data.heroIntro}
  ogTitle={page.data.ogTitle}
  ogDescription={page.data.ogDescription}
  ogImage={page.data.ogImage}
>
  <Schema
    slot="head"
    pageId={page.id}
    title={page.data.title}
    description={page.data.description}
    canonical={canonical}
    h1={page.data.h1}
    faq={page.data.faq}
    breadcrumbs={breadcrumbs}
    hasTool={hasToolCategories}
    articleImages={articleImages}
    video={homeVideoSchema}
  />
  {
    hasPlaceholder ? (
      <noscript slot="head">
        <style is:inline>
          .tool__category[data-mounted='false'] {
            display: none !important;
          }
        </style>
      </noscript>
    ) : null
  }
  {parts[0]?.trim() ? <div class="article" set:html={parts[0]} /> : null}
  {
    hasPlaceholder ? (
      <Tool
        toolCategories={page.data.toolCategories}
        testPhrase={page.data.testPhrase}
        showDecorations={page.data.showDecorations}
        showEffects={page.data.showEffects}
        showCombined={page.data.showCombined}
        showGlitch={page.data.showGlitch}
        charLimit={page.data.charLimit}
        pageFile={page.id}
      />
    ) : null
  }
  {
    page.data.heroIntroBelow ? (
      <p class="hero-intro hero-intro--below">{page.data.heroIntroBelow}</p>
    ) : null
  }
  {
    showHomeVideo ? (
      <div class="article">
        {belowBefore.trim() ? <Fragment set:html={belowBefore} /> : null}
        <HomeVideo site={Astro.site!} />
        {belowAfter.trim() ? <Fragment set:html={belowAfter} /> : null}
      </div>
    ) : parts[1]?.trim() ? (
      <div class="article" set:html={parts[1]} />
    ) : null
  }
  <Faq items={page.data.faq} />
  <RelatedTools slugs={page.data.relatedTools} currentId={page.id} includeAllTools={hasToolCategories} />
</PageLayout>
